    "@fontsource/figtree": "^5.1.0",
    "@hookform/resolvers": "^3.9.1",
    "@mui/icons-material": "^6.1.9",
    "@mui/material": "^6.1.9",
    "@mui/system": "^6.1.9",
    "@mui/x-charts": "^7.22.2",
    "@popperjs/core": "^2.11.8",
    "@reduxjs/toolkit": "^2.3.0",
