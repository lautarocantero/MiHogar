# Proyecto de Supabase (Project Settings → API). Copiar a `.env` y completar.
# La clave pública (anon / publishable) puede ir en el cliente: el acceso a los datos
# lo controla RLS y el contenido del vault viaja cifrado con la clave del hogar.
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<clave-publica>
